{
  "name": "@nythera/server",
  "version": "0.1.0",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "DATABASE_PROVIDER=sqlite DATABASE_URL=file:./test.db vitest run --pool=forks --poolOptions.forks.singleFork=true",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:select": "node scripts/select-prisma-schema.mjs",
    "db:generate:sqlite": "DATABASE_PROVIDER=sqlite npm run db:select && prisma generate",
    "db:generate:postgresql": "DATABASE_PROVIDER=postgresql npm run db:select && prisma generate",
    "db:migrate:sqlite": "DATABASE_PROVIDER=sqlite npm run db:select && prisma db push",
    "db:migrate:postgresql": "DATABASE_PROVIDER=postgresql npm run db:select && prisma db push",
    "db:reset:sqlite": "DATABASE_PROVIDER=sqlite npm run db:select && prisma db push --force-reset"
  },
  "dependencies": {
    "@fastify/websocket": "^11.3.0",
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "argon2": "^0.45.1",
    "better-sqlite3": "^11.8.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.3",
    "fastify-plugin": "^6.0.0",
    "pg": "^8.13.0",
    "pino": "^10.3.1",
    "@nythera/shared": "*",
    "@nythera/content-schema": "*"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^20.19.0",
    "@types/pg": "^8.11.10",
    "pino-pretty": "^13.1.3",
    "prisma": "7.10.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.2"
  }
}
